{
  "name": "isarklima-muenchen",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run generate:pages",
    "dev": "astro dev",
    "generate:pages": "node scripts/generate-page-data.mjs",
    "check:generated": "node scripts/generate-page-data.mjs --check",
    "prebuild": "npm run generate:pages",
    "build": "astro build",
    "postbuild": "node scripts/audit-build.mjs",
    "preview": "astro preview",
    "check": "astro sync && astro check",
    "check:all": "npm run check:generated && npm run check && npm run build",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "astro": "^7.2.8",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "cheerio": "^1.2.0"
  }
}
