---
import '@fontsource-variable/archivo';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { site } from '../data/site';
import type { Language } from '../data/types';

interface Breadcrumb { name: string; path: string; }
interface Collection { name: string; items: { name: string; path: string }[]; }
interface Props {
  title: string;
  description: string;
  lang?: Language;
  path?: string;
  alternatePath?: string;
  image?: string;
  breadcrumbs?: Breadcrumb[];
  article?: { headline?: string; published: Date; updated?: Date; author?: string };
  faq?: { question: string; answer: string }[];
  collection?: Collection;
  service?: boolean;
  serviceName?: string;
  noindex?: boolean;
}

const { title, description, lang = 'de', path = Astro.url.pathname, alternatePath, image = site.socialImage, breadcrumbs = [], article, faq = [], collection, service = false, serviceName = title, noindex = false } = Astro.props;
const siteUrl = Astro.site ?? new URL(site.defaultUrl);
const canonical = new URL(path, siteUrl).toString();
const alternate = alternatePath ? new URL(alternatePath, siteUrl).toString() : undefined;
const imageUrl = new URL(image, siteUrl).toString();
const organizationId = new URL('/#organization', siteUrl).toString();
const websiteId = new URL('/#website', siteUrl).toString();
const webpageId = `${canonical}#webpage`;
const organization = { '@type': 'Organization', '@id': organizationId, name: site.name, url: new URL('/', siteUrl).toString(), logo: new URL('/brand/isarklima-mark.svg', siteUrl).toString() };
const website = { '@type': 'WebSite', '@id': websiteId, url: new URL('/', siteUrl).toString(), name: site.name, publisher: { '@id': organizationId }, inLanguage: ['de-DE', 'en-DE'] };
const webpage = { '@type': collection ? 'CollectionPage' : 'WebPage', '@id': webpageId, url: canonical, name: title, description, inLanguage: lang === 'de' ? 'de-DE' : 'en-DE', isPartOf: { '@id': websiteId }, primaryImageOfPage: { '@type': 'ImageObject', url: imageUrl } };
const indexSite = import.meta.env.PUBLIC_INDEX_SITE === 'true';
const schemas = [
  { '@context': 'https://schema.org', ...organization },
  { '@context': 'https://schema.org', ...website },
  { '@context': 'https://schema.org', ...webpage },
  ...(service ? [{ '@context': 'https://schema.org', '@type': 'Service', '@id': `${canonical}#service`, name: serviceName, description, url: canonical, serviceType: lang === 'de' ? 'Planung und Installation von Split-Klimaanlagen' : 'Split air conditioning planning and installation', provider: { '@id': organizationId }, areaServed: { '@type': 'Country', name: 'Germany' } }] : []),
  ...(collection ? [{ '@context': 'https://schema.org', '@type': 'ItemList', '@id': `${canonical}#articles`, name: collection.name, itemListElement: collection.items.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.name, url: new URL(item.path, siteUrl).toString() })) }] : []),
  ...(breadcrumbs.length > 1 ? [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: breadcrumbs.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.name, item: new URL(item.path, siteUrl).toString() })) }] : []),
  ...(article ? [{ '@context': 'https://schema.org', '@type': 'BlogPosting', headline: article.headline ?? title, description, inLanguage: lang === 'de' ? 'de-DE' : 'en-DE', datePublished: article.published.toISOString(), dateModified: (article.updated ?? article.published).toISOString(), image: imageUrl, ...(article.author ? { author: { '@type': 'Organization', name: article.author, url: organization.url } } : {}), publisher: { '@id': organizationId }, mainEntityOfPage: { '@id': webpageId } }] : []),
  ...(faq.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) }] : []),
];
---

<!doctype html>
<html lang={lang === 'de' ? 'de-DE' : 'en-DE'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={indexSite && !noindex ? 'index, follow' : 'noindex, nofollow'} />
    <meta name="theme-color" content="#071a22" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternate && <>
      <link rel="alternate" hreflang={lang === 'de' ? 'en-DE' : 'de-DE'} href={alternate} />
      <link rel="alternate" hreflang={lang === 'de' ? 'de-DE' : 'en-DE'} href={canonical} />
      <link rel="alternate" hreflang="x-default" href={lang === 'de' ? canonical : alternate} />
    </>}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="IsarKlima Blog" href={lang === 'de' ? '/rss.xml' : '/en/rss.xml'} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_DE'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
    {schemas.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{lang === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}</a>
    <slot />
  </body>
</html>
