---
import { blogSlug, getPublishedPosts } from '../lib/blog';
import BlogResponsiveImage from './BlogResponsiveImage.astro';
interface Props { lang: 'de' | 'en'; }
const { lang } = Astro.props;
const posts = await getPublishedPosts(lang === 'de' ? 'de-DE' : 'en-DE');
---
<section class="guide-listing shell" id="artikel" aria-labelledby="guide-list-title">
  <div class="guide-list-heading"><p>{lang === 'de' ? 'Neu im IsarKlima Blog' : 'New on the IsarKlima blog'}</p><h2 class="display-heading" id="guide-list-title">{lang === 'de' ? 'Aktuelle Artikel' : 'Latest articles'}</h2></div>
  <p class="guide-swipe-hint">{lang === 'de' ? 'Seitlich wischen, um weitere Artikel zu sehen' : 'Swipe sideways to see more articles'}</p>
  <div class="guide-grid">
    {posts.map((post, index) => <article class:list={['guide-card', { featured: index === 0 }]}>
      <a class="guide-image" href={lang === 'de' ? `/ratgeber/${blogSlug(post)}/` : `/en/guides/${blogSlug(post)}/`}><BlogResponsiveImage src={post.data.image!} alt={post.data.imageAlt} sizes={index === 0 ? '(max-width: 700px) min(86vw, 348px), (max-width: 1050px) calc(100vw - 48px), (max-width: 1288px) 56vw, 700px' : '(max-width: 700px) min(86vw, 348px), (max-width: 1050px) 44vw, (max-width: 1288px) 20vw, 260px'} /></a>
      <div class="guide-card-copy"><p class="guide-card-meta"><span>{String(index + 1).padStart(2, '0')}</span>{post.data.category}</p><h3 class="guide-card-title"><a href={lang === 'de' ? `/ratgeber/${blogSlug(post)}/` : `/en/guides/${blogSlug(post)}/`}>{post.data.title}</a></h3><time class="guide-date" datetime={post.data.publishDate.toISOString().slice(0, 10)}>{post.data.publishDate.toLocaleDateString(lang === 'de' ? 'de-DE' : 'en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}</time></div>
    </article>)}
  </div>
</section>
