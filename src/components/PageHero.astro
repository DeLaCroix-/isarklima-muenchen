---
import ResponsiveImage from './ResponsiveImage.astro';
interface Props { eyebrow: string; h1: string; intro: string; image: string; imageAlt: string; note?: string; home?: boolean; lang: 'de' | 'en'; }
const { eyebrow, h1, intro, image, imageAlt, note, home = false, lang } = Astro.props;
---
<section class:list={['page-hero shell', { 'page-hero--home': home }]}>
  <div class="page-hero-copy">
    <p class="eyebrow"><span></span>{eyebrow}</p>
    <h1>{h1}</h1>
    <p class="hero-intro">{intro}</p>
    <div class="hero-actions"><a class="button button-primary" href="#projekt">{lang === 'en' ? 'Prepare your project' : 'Projekt vorbereiten'}<span aria-hidden="true">→</span></a><a class="text-link" href="#inhalt">{lang === 'en' ? 'Explore the details' : 'Details ansehen'}</a></div>
    <div class="hero-index"><span>48.14° N</span><span>11.58° E</span><span>{lang === 'en' ? 'Munich' : 'München'}</span></div>
  </div>
  <div class="page-hero-visual">
    <div class="hero-image-wrap"><ResponsiveImage name={image} alt={imageAlt} loading="eager" fetchpriority="high" sizes="(max-width: 900px) 100vw, 46vw" /></div>
    <div class="hero-badge"><span aria-hidden="true"></span><div><small>{lang === 'en' ? 'Air conditioning' : 'Klimaanlagen'}</small><strong>{note ?? (lang === 'en' ? 'Planning & installation' : 'Planung & Montage')}</strong></div></div>
    <div class="hero-temperature" aria-hidden="true"><strong>21°</strong><span>SET</span></div>
  </div>
</section>
