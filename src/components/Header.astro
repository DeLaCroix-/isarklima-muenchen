---
import { labels, localizedHome, navigation } from '../data/site';
import type { Language } from '../data/types';
interface Props { lang: Language; alternatePath: string; }
const { lang, alternatePath } = Astro.props;
const t = labels[lang];
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => href === currentPath
  || (href === '/ratgeber/' && currentPath.startsWith('/ratgeber/'))
  || (href === '/en/guides/' && currentPath.startsWith('/en/guides/'));
const alternateLanguage = lang === 'de'
  ? { flag: '/flags/flag-uk.svg', label: t.language, ariaLabel: 'English — zur englischen Version wechseln' }
  : { flag: '/flags/flag-de.svg', label: t.language, ariaLabel: 'Deutsch — switch to the German version' };
const contactPath = lang === 'de' ? '/kontakt/' : '/en/contact/';
---
<div class="preview-bar" role="status"><span>{t.preview}</span><p>{t.previewText}</p></div>
<header class="site-header shell">
  <a class="brand" href={localizedHome(lang)} aria-label={`${t.home} — IsarKlima`}><img src="/brand/isarklima-logo.svg" width="215" height="46" alt="IsarKlima" /></a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" data-open-label={t.close} data-closed-label={t.menu}><span>{t.menu}</span><i aria-hidden="true"></i></button>
  <nav id="primary-nav" aria-label={t.nav}>
    {navigation[lang].map(([href, label]) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
    <a class="nav-language" href={alternatePath} hreflang={lang === 'de' ? 'en' : 'de'} aria-label={alternateLanguage.ariaLabel} title={alternateLanguage.ariaLabel}>
      <img class="language-flag" src={alternateLanguage.flag} width="24" height="16" alt="" aria-hidden="true" />
      <span>{alternateLanguage.label}</span>
      <i aria-hidden="true">↗</i>
    </a>
  </nav>
  <a class="header-cta" href={contactPath} aria-current={isCurrent(contactPath) ? 'page' : undefined}>{t.request}<span aria-hidden="true">↗</span></a>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#primary-nav');
  const label = button?.querySelector('span');
  const header = button?.closest('.site-header');
  const setOpen = (open: boolean) => {
    button?.setAttribute('aria-expanded', String(open));
    nav?.toggleAttribute('data-open', open);
    if (label && button) label.textContent = open ? button.dataset.openLabel ?? '' : button.dataset.closedLabel ?? '';
  };
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    setOpen(!open);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      button.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (button?.getAttribute('aria-expanded') !== 'true' || !(event.target instanceof Node) || header?.contains(event.target)) return;
    setOpen(false);
  });
  window.matchMedia('(min-width: 1051px)').addEventListener('change', (event) => {
    if (event.matches) setOpen(false);
  });
</script>
