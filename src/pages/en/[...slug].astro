---
import StandardPage from '../../components/StandardPage.astro';
import BlogIndex from '../../components/BlogIndex.astro';
import { pages } from '../../data/pages';
export function getStaticPaths() {
  return pages.filter((page) => page.lang === 'en' && page.path !== '/en/').map((page) => ({ params: { slug: page.path.slice(4, -1) }, props: { page } }));
}
const { page } = Astro.props;
---
{page.key === 'guides' ? <BlogIndex {page} /> : <StandardPage {page} />}
