---
import StandardPage from '../components/StandardPage.astro';
import BlogIndex from '../components/BlogIndex.astro';
import { pages } from '../data/pages';
export function getStaticPaths() {
  return pages.filter((page) => page.lang === 'de' && page.path !== '/').map((page) => ({ params: { slug: page.path.slice(1, -1) }, props: { page } }));
}
const { page } = Astro.props;
---
{page.key === 'guides' ? <BlogIndex {page} /> : <StandardPage {page} />}
