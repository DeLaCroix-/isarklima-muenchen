---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Seite nicht gefunden | IsarKlima" description="Die angeforderte Seite wurde nicht gefunden." path="/404/" noindex>
  <Header lang="de" alternatePath="/en/" />
  <main id="main-content" class="not-found shell"><p>404</p><h1>Diese Seite ist nicht hier.</h1><span>Die Adresse ist möglicherweise veraltet oder falsch geschrieben.</span><a class="button button-primary" href="/">Zur Startseite →</a></main>
  <Footer lang="de" />
</BaseLayout>
